# Copy to .env for local development. Never commit real credentials.
# Frontend configuration is extractable from distributed builds.
# Keep privileged provider credentials and authorization on the backend.
VITE_MOMO_API_BASE_URL=https://payments-proxy.vercel.app/api
VITE_EXCHANGE_RATE_API_URL=https://blockchain.info/ticker?cors=true
VITE_SPREAD=0.021
VITE_MOMO_WITHDRAWAL_FIXED_FEE=120
VITE_ECASH_LIGHTNING_FEE=10
VITE_RWF_USD_PEG=1500
VITE_POLLING_INTERVAL_MS=5000
VITE_POLLING_TIMEOUT_MS=120000
VITE_TX_FEE_PERCENTAGE=0

# Proxy transit key: not a server authorization secret.
VITE_ENCRYPTION_KEY=

# Optional Breez SDK client key for Spark/on-chain and Dollar conversions.
# Request your own key from https://breez.technology/request-api-key/.
BREEZ_API_KEY=

# Optional Lightning-address service overrides:
# VITE_NPUB_CASH_API_URL=https://www.28waves.com
# VITE_NPUB_DOMAIN=28waves.com
# VITE_NPUB_CASH_BACKEND_URL=https://npubcash-server.runsite.app
# VITE_LIGHTNING_API_ENDPOINT=https://payments-proxy.vercel.app/api/payment/mint
